{
  "name": "takuai-template",
  "version": "0.3.2",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "start:preview": "node scripts/start-preview.js",
    "start:edit": "node scripts/start-edit.js",
    "install:deps": "node scripts/install-with-status.js",
    "test": "node scripts/run-tests.js",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:watch": "pnpm run watch:format & pnpm run dev",
    "check:slots": "node scripts/check-design-mode-slots.js",
    "prebuild": "pnpm run check:slots",
    "build": "next build",
    "start": "next start",
    "release:check": "node scripts/check-template-release-channel.js --channel=taku3 --tag=taku-3.0.2-template",
    "studio": "drizzle-kit studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "auto-fix": "pnpm run check && pnpm run type-check",
    "watch:format": "node scripts/watch-format.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.541.0",
    "next": "15.5.21",
    "postcss": "^8.5.23",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "nanoid": "3.3.18",
      "picomatch": "2.3.2",
      "postcss": "8.5.26",
      "yaml": "2.8.3",
      "sharp": "0.35.0"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "**/*.{css,scss}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^1.3.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5"
  }
}
